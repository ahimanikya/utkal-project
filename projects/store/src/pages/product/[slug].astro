---
import Store from '../../layouts/Store.astro';
import ProductArt from '../../components/ProductArt.astro';
import products from '../../data/products.json';
import sampleSpec from '../../../kb/specs/sample-specifications-v4.json';
export function getStaticPaths(){return products.map(product=>({params:{slug:product.id},props:{product}}));}
const {product}=Astro.props;
---
<Store title={product.name}><div class="wrap"><p class="breadcrumb"><a href="/#collection">The collection</a> / {product.name}</p><section class="product-detail"><ProductArt product={product} large/><div><p class="eyebrow">{product.collection} · DESIGN STUDY</p><h1>{product.name}</h1><p class="lead">{product.description}</p><p class="price">Price to be confirmed</p><form id="selection-form" data-product={product.id}><label for="variant">{product.kind==='tee'?'Proposed size':(product.kind==='bottle'||product.kind==='bag')?'Proposed colour':'Edition'}</label><select id="variant" name="variant" required>{product.variants.map(v=><option value={v}>{v}</option>)}</select><label for="quantity">Quantity</label><input id="quantity" name="quantity" type="number" min="1" max="10" value="1" required/><button class="button" type="submit">Save to your selection ↗</button></form><p id="save-status" role="status" aria-live="polite"></p><a class="text-link" href="/bag/">View your selection →</a><details open><summary>Before this becomes a product</summary><p>This AI-generated mockup explores the design; it is not a manufactured sample. Materials, dimensions, print durability, applicable sizing, price and delivery dates will be confirmed after vendor samples are reviewed.</p></details><p><a href="/design-review/">Review the collection artwork →</a></p><p class="notice">Saving a selection does not reserve stock, place an order or send information to us.</p></div></section>{product.id==='coffee-cup'&&<section class="closing" style="padding-top:0"><p class="eyebrow">THE STORY ON YOUR CUP</p><h2>{sampleSpec.cup_story.title}</h2><p class="lead">{sampleSpec.cup_story.scenes.join(' · ')}</p><img src={product.artwork} alt="Current illustrated cup wrap: riverbank launch, sea voyage and welcoming shore" style="display:block;width:100%;max-width:900px;background:#fffaf1;padding:25px"/><p class="design-note">Boita Bandana’s floating boats and maritime remembrance are described by the <a href={sampleSpec.cup_story.source_url}>Ministry of Culture</a>. The pictured journey is an artistic interpretation, not a reconstruction of a particular voyage. No narrative paragraph will be printed on the cup.</p></section>}<section class="closing"><h2>Made from one design.</h2><p>The cups, Tasar bags and T-shirt back share a maritime story direction. The T-shirt front and bottle retain the Utkal emblem. Illustrations are concept renders; shared production artwork still needs to be prepared. Materials and exact placement will be checked against the supplier’s blank.</p><a class="text-link" href="/design-review/">See the current product sheet →</a></section></div></Store>
<script>
import products from '../../data/products.json';
import {loadCart,saveCart,addItem} from '../../lib/cart.mjs';
const form=document.querySelector<HTMLFormElement>('#selection-form')!;
form.addEventListener('submit',event=>{event.preventDefault();const data=new FormData(form);const status=document.querySelector('#save-status')!;try{const cart=addItem(loadCart(localStorage,products),{id:form.dataset.product,variant:String(data.get('variant')),quantity:Number(data.get('quantity'))},products);saveCart(localStorage,cart);status.textContent='Saved on this device. View your selection when you’re ready.';}catch(error){status.textContent=error instanceof Error?error.message:'Unable to save your selection in this browser.';}});
</script>
