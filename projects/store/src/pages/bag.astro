---
import Store from '../layouts/Store.astro';
---
<Store title="Your selection"><section class="wrap selection"><p class="eyebrow">A LITTLE ODISHA, CHOSEN BY YOU</p><h1>Your <em>selection.</em></h1><p class="lead">A place to keep your favourites while the first collection takes shape.</p><p class="notice">Saved only in this browser. No personal details are collected, and nothing is sent to a vendor.</p><div id="selection-items"></div><p id="selection-status" role="status"></p><div class="selection-summary"><h2 id="selection-count">Your selection</h2><p>Prices and delivery will be confirmed before ordering opens.</p><button class="button" disabled>Ordering opens after sample approval</button><a class="text-link" href="/#collection">Continue exploring →</a></div><noscript><p>Enable JavaScript to view a selection saved in this browser. Ordering is not open.</p></noscript></section></Store>
<script>
import products from '../data/products.json';
import {loadCart,saveCart} from '../lib/cart.mjs';
const container=document.querySelector('#selection-items')!;const status=document.querySelector('#selection-status')!;
let storage: Storage | null=null;try{storage=localStorage;}catch{}
let cart=loadCart(storage,products);
function render(){container.replaceChildren();if(!cart.length){const empty=document.createElement('p');empty.className='empty';empty.textContent='Your selection is empty. Find a design you’d like to keep.';container.append(empty);}for(const item of cart){const product=products.find(p=>p.id===item.id)!;const row=document.createElement('article');row.className='selection-row';const link=document.createElement('a');link.href='/product/'+item.id+'/';link.textContent=product.name;const detail=document.createElement('p');detail.textContent=item.variant+' · Quantity '+item.quantity;const remove=document.createElement('button');remove.type='button';remove.textContent='Remove';remove.setAttribute('aria-label','Remove '+product.name+' '+item.variant);remove.addEventListener('click',()=>{const next=cart.filter(i=>!(i.id===item.id&&i.variant===item.variant));try{saveCart(storage,next);cart=next;render();status.textContent='Removed from your selection.';}catch(error){status.textContent=error instanceof Error?error.message:'Unable to update selection.';}});row.append(link,detail,remove);container.append(row);}const count=cart.reduce((n,i)=>n+i.quantity,0);document.querySelector('#selection-count')!.textContent=count+' '+(count===1?'item':'items')+' selected';}render();
</script>
