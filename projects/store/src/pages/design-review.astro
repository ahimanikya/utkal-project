---
import Store from '../layouts/Store.astro';
import ProductArt from '../components/ProductArt.astro';
import products from '../data/products.json';
const sizes=['240 × 260 mm','280 × 300 mm','200 × 85 mm','70 × 150 mm'];
---
<Store title="Sea & Stone · design review"><div class="wrap"><section class="collection"><p class="eyebrow">COLLECTION 01 · A DESIGN PROPOSAL</p><h1>Sea &amp; <em>Stone.</em></h1><p class="lead">A book becomes a sail.<br/>A familiar word travels with you.</p><p>Four everyday objects, designed around the sea, laterite earth and the language of belonging. English and Odia have their own space.</p><p class="design-note">These are AI-generated visual studies, not photographs of finished products. The flat vector studies below explore consistent lettering and print placement; details differ from the rendered concepts. We will reconcile the selected design with the vendor’s template before making samples.</p><div class="actions" style="margin-top:24px"><a class="button" href="/artwork/utkal-sea-and-stone-review-v1.zip" download>Download the design review pack ↓</a></div></section>
{products.map((product,i)=><section class="artwork-review"><div><ProductArt product={product}/><p class="design-note">Visual direction · {product.language==='or'?'Odia':'English'}</p></div><div><p class="eyebrow">0{i+1} · {product.name}</p><h2>{product.kind==='tee'?'Wear the story.':product.kind==='bag'?'Carry the coast.':product.kind==='cup'?'A daily ritual.':'Take the sea along.'}</h2><p class="lead">{product.description}</p><div class:list={['artwork-proof',{'dark':product.kind==='tee','sea':product.kind==='bottle'}]}><img src={product.artwork} alt={product.name+' flat vector artwork candidate'}/></div><p class="design-note">Proposed artwork canvas: {sizes[i]}. Placement, scale and print process need a supplier proof.</p><a href={product.artwork} download>Download vector artwork ↓</a></div></section>)}
<section class="closing"><h2>Designed here.<br/><em>Made carefully, next.</em></h2><p class="lead">Choose the designs first. Then compare real materials, colours and print samples.</p><p>Only the T-shirt’s black base is confirmed. Ecru fabric, a two-tone ivory mug and a matte sea-blue bottle are proposed finishes. Prices and orders remain closed.</p><a class="text-link" href="/#collection">Back to the collection →</a></section></div></Store>
