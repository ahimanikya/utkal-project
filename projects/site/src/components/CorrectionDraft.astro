---
import {correctionEntries as entries} from '../data/correction-entries';
---
<section class="correction-draft" aria-labelledby="correction-heading">
 <p class="eyebrow">Make the record better</p><h2 id="correction-heading">Share a correction or a discovery.</h2><p>Keep the entry, your suggested change and its evidence together. This tool prepares a text file on your device. Nothing is sent while you prepare it. When ready, open a public GitHub issue and review it there before posting. A GitHub account is needed to submit.</p>
 <p class="draft-note">Download your draft before leaving; it is not saved automatically. Please leave out private contact details and information you do not have permission to share.</p>
 <fieldset id="correction-fields" disabled><legend>Your editorial draft</legend>
 <label class="utk-field">Entry to improve<select id="correction-page"><option value="">Choose an entry</option><option value="__new__">Suggest a new subject</option>{entries.map(e=><option value={e.href}>{e.title}</option>)}</select></label>
 <label class="utk-field" id="new-subject-field" hidden>New subject name<input id="correction-subject" aria-describedby="correction-subject-help" maxlength="160" placeholder="A place, a dish, a language or a life"/></label><span class="field-help" hidden id="correction-subject-help" data-count-for="correction-subject">0 / 160 characters</span>
 <label class="utk-field">Contribution type<select id="correction-kind"><option>Correction</option><option>Additional knowledge</option><option>Personal recollection</option></select></label>
 <label class="utk-field">Suggested change<textarea id="correction-text" aria-describedby="correction-text-help" minlength="10" maxlength="10000" rows="5" placeholder="What should change, and why?"/></label><span class="field-help" id="correction-text-help" data-count-for="correction-text">0 / 10,000 characters</span>
 <label class="utk-field">Supporting source or firsthand context<textarea id="correction-evidence" aria-describedby="correction-evidence-help" minlength="5" maxlength="3000" rows="3" placeholder="A source link, a book and page, or who witnessed this and when."/></label><span class="field-help" id="correction-evidence-help" data-count-for="correction-evidence">0 / 3,000 characters</span>
 <label class="utk-field">Requested public credit (optional)<input id="correction-credit" aria-describedby="correction-credit-help" maxlength="120" placeholder="The name you would like credited"/></label><span class="field-help" id="correction-credit-help" data-count-for="correction-credit">0 / 120 characters</span>
 <div class="actions"><button type="button" class="button utk-button" id="prepare-correction">Preview draft</button><button type="button" id="download-correction" class="utk-button utk-button--secondary">Download draft</button><button type="button" id="copy-correction" class="utk-button utk-button--secondary">Copy draft</button><button type="button" id="clear-correction" class="utk-button utk-button--secondary">Clear draft</button></div><div class="public-issue-step"><p id="public-issue-notice"><strong>GitHub submissions are public.</strong> Your issue, username and any attachments become visible on GitHub when you post. Leave out private contact details, private stories and material you cannot share publicly. Posting an issue does not publish an encyclopedia entry.</p><button type="button" id="prepare-public-issue" aria-describedby="public-issue-notice" class="utk-button utk-button--secondary">Prepare public GitHub issue</button><p id="public-issue-help" role="status"></p><a id="public-issue-link" class="button utk-button" hidden target="_blank" rel="noopener noreferrer">Open public GitHub issue ↗</a></div></fieldset>
 <p id="correction-status" role="status" aria-live="polite"></p><button type="button" id="confirm-draft-copy" class="utk-button utk-button--secondary" hidden>I have kept a copy of this draft</button><pre id="correction-preview" hidden tabindex="0" aria-label="Prepared correction draft"></pre><noscript><p>To prepare a draft manually, note the entry’s title and link, your suggested change, supporting evidence and requested credit.</p></noscript>
</section>
<script>
 import {correctionDraft,publicIssueLink} from '../lib/correction.mjs';
 import {downloadFile} from '../lib/downloads.mjs';
 import {createDraftRetention} from '../lib/draft-retention.mjs';
 const entries=Array.from(document.querySelectorAll<HTMLOptionElement>('#correction-page option')).filter(option=>option.value.startsWith('/')).map(option=>({title:option.textContent,href:option.value}));
 const field=(id:string)=>document.getElementById(id) as HTMLInputElement;
 const output=document.querySelector<HTMLPreElement>('#correction-preview')!,status=document.querySelector('#correction-status')!,page=document.querySelector<HTMLSelectElement>('#correction-page')!,fields=document.querySelector<HTMLFieldSetElement>('#correction-fields')!;
 const issueLink=document.querySelector<HTMLAnchorElement>('#public-issue-link')!,issueHelp=document.querySelector('#public-issue-help')!;
 const retention=createDraftRetention(),keptCopy=document.querySelector<HTMLButtonElement>('#confirm-draft-copy')!;
 let downloadRevision:number|null=null;
 const requested=new URLSearchParams(location.search).get('page');if(entries.some(p=>p.href===requested))page.value=requested!;
 if(new URLSearchParams(location.search).get('new')==='1'){page.value='__new__';field('correction-kind').value='Additional knowledge';}
 function showSubject(){for(const id of ['new-subject-field','correction-subject-help'])document.getElementById(id)!.hidden=page.value!=='__new__';}
 showSubject();fields.disabled=false;
 function value(){return {page:page.value,subject:field('correction-subject').value,kind:field('correction-kind').value,correction:field('correction-text').value,evidence:field('correction-evidence').value,credit:field('correction-credit').value};}
 function resetError(input:HTMLElement){input.removeAttribute('aria-invalid');const help=input.getAttribute('aria-describedby')?.split(' ').filter(id=>id!=='correction-status').join(' ');if(help)input.setAttribute('aria-describedby',help);else input.removeAttribute('aria-describedby');}
 function resetErrors(){fields.querySelectorAll<HTMLElement>('[aria-invalid]').forEach(resetError);}
 function counts(){fields.querySelectorAll<HTMLElement>('[data-count-for]').forEach(note=>{const input=field(note.dataset.countFor!);note.textContent=`${input.value.length.toLocaleString()} / ${input.maxLength.toLocaleString()} characters`;});}
 function invalidate(event?:Event){retention.edit([value().subject,value().correction,value().evidence,value().credit].some(v=>v.trim()));downloadRevision=null;keptCopy.hidden=true;issueLink.hidden=true;issueLink.removeAttribute('href');issueHelp.textContent='';output.hidden=true;status.textContent='';if(event?.target instanceof HTMLElement)resetError(event.target);showSubject();counts();}
 function report(error:any){status.textContent=error.message||'Could not prepare that draft.';const input=document.getElementById('correction-'+error.field);if(input){showSubject();input.setAttribute('aria-invalid','true');input.setAttribute('aria-describedby',[...(input.getAttribute('aria-describedby')||'').split(' ').filter(Boolean),'correction-status'].filter((v,i,a)=>a.indexOf(v)===i).join(' '));input.focus();}}
 function prepare(){resetErrors();const draft=correctionDraft(value(),entries);output.textContent=draft;output.hidden=false;status.textContent='Prepared on your device. Nothing has been sent.';output.focus();return draft;}
 for(const action of ['prepare','download','copy'])document.querySelector<HTMLButtonElement>('#'+action+'-correction')!.addEventListener('click',async()=>{
  let draft:string;try{draft=prepare();}catch(error){report(error);return;}
  if(action==='download'){
   try{downloadFile(draft,'utkal-correction-draft.txt','text/plain;charset=utf-8');downloadRevision=retention.version();keptCopy.hidden=false;status.textContent='Download requested. Check your browser’s downloads for utkal-correction-draft.txt, then confirm that you kept a copy. Nothing has been submitted.';}
   catch{downloadRevision=null;keptCopy.hidden=true;status.textContent='The download could not be prepared. Your draft is still here. Copy it or select the preview text to keep it.';}
  }
  if(action==='copy'){const atRevision=retention.version();try{await navigator.clipboard.writeText(draft);if(retention.keep(atRevision)){downloadRevision=null;keptCopy.hidden=true;status.textContent='Draft copied. It has not been submitted.';}}catch{if(retention.isCurrent(atRevision))status.textContent='Copy was unavailable. Select and copy the preview text manually.';}}
 });
 document.querySelector('#prepare-public-issue')!.addEventListener('click',()=>{issueLink.hidden=true;issueLink.removeAttribute('href');try{prepare();const result=publicIssueLink(value(),entries);issueLink.href=result.url;issueLink.hidden=false;issueHelp.textContent=result.prefilled?'Your draft will be sent to GitHub when you open this link. Review it there, then choose whether to submit.':'This draft is too long to put in a link. Copy the complete draft above, open GitHub, and paste it into a new issue. No text has been cut.';issueLink.focus();}catch(error){report(error);}});
 keptCopy.addEventListener('click',()=>{if(downloadRevision===null||!retention.keep(downloadRevision))return;downloadRevision=null;keptCopy.hidden=true;status.textContent='You confirmed that you kept this version. Further edits will need a new copy. Nothing has been submitted.';document.querySelector<HTMLButtonElement>('#download-correction')!.focus();});
 fields.addEventListener('input',invalidate);fields.addEventListener('change',invalidate);
 document.querySelector('#clear-correction')!.addEventListener('click',()=>{if(!window.confirm('Clear this draft? Download or copy it first if you want to keep it.'))return;for(const id of ['subject','text','evidence','credit'])field('correction-'+id).value='';resetErrors();invalidate();status.textContent='Draft cleared. Nothing was submitted.';field(page.value==='__new__'?'correction-subject':'correction-text').focus();});
 window.addEventListener('beforeunload',event=>{if(retention.needsReminder()){event.preventDefault();event.returnValue='';}});counts();
</script>
<style>.correction-draft [hidden]{display:none!important}.field-help{display:block;font-size:12px;font-weight:400;margin-top:6px}.correction-draft{max-width:900px;margin:40px 0 65px;padding:32px;background:var(--paper);border-top:4px solid var(--earth)}.correction-draft h2{margin:15px 0 22px}.correction-draft p{margin:18px 0}.draft-note{font-size:14px}.public-issue-step{border-top:1px solid var(--line);margin-top:28px;padding-top:10px}.correction-draft fieldset{border:0;padding:0;margin:28px 0;min-width:0}.correction-draft legend{font-weight:600}.correction-draft label{display:block;font-size:14px;font-weight:600;margin:20px 0}.correction-draft input,.correction-draft select,.correction-draft textarea{display:block;width:100%;max-width:100%;padding:13px;border:1px solid var(--muted);background:var(--light);font:inherit;margin-top:8px}.correction-draft button{cursor:pointer;min-height:44px}.correction-draft pre{white-space:pre-wrap;overflow-wrap:anywhere;font:14px/1.7 system-ui;padding:22px;background:var(--light)}#correction-status{color:var(--earth)}@media(max-width:600px){.correction-draft{padding:22px}.correction-draft .actions{align-items:start;flex-direction:column}}</style>
