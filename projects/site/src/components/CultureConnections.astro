---
import {allowsPage} from '../data/edition';
import {cultureTrailsFor} from '../data/culture-trails';
const {path,all=false}=Astro.props;
const trails=cultureTrailsFor(path,all);
---
{trails.length>0&&<section class="culture-connections" aria-label="Places, voices and stories"><p class="eyebrow">Follow a cultural thread</p><h2>A place has more than one story.</h2><p class="trail-intro">Follow these reading trails between landscapes, language and literature. Let them inspire your own visit.</p><div class="trail-grid">{trails.map(t=><article class="culture-trail" id={t.id}><img src={t.image} width={t.width} height={t.height} alt={t.alt} loading="lazy" class:list={{'trail-script':t.id==='mayurbhanj-voices'}}/><div><p class="eyebrow">{t.place} · Reading trail</p><h3>{t.title}</h3><p>{t.text}</p><p class="trail-prompt">{t.prompt}</p><nav aria-label={t.title}>{t.links.map(l=><a class="text-link" href={l.href}>{l.title} →</a>)}</nav></div></article>)}</div><p class="trail-note">Use the linked visitor guides to begin planning. Reading trails connect ideas; walking routes, performances and visits with local hosts need separate confirmation.</p><details class="trail-credits"><summary>Reading-trail sources & image credits</summary>{trails.map(t=><div><h3>{t.title}</h3><ul>{t.sources.map(s=><li><a href={s.url}>{s.title}</a><p>{s.inspection}</p></li>)}</ul><p><a href={t.image_credit.source}>Image</a> by {t.image_credit.creator} · <a href={t.image_credit.license_url}>{t.image_credit.license}</a>. {t.image_credit.changes} {t.id==='balasore-fiction'?'Commemorative bust, not a photograph of Senapati himself.':t.id==='mayurbhanj-voices'?'The sample reads “Ol Chiki”, the name of the script.':''}</p></div>)}</details>{!all&&allowsPage('/stories/culture-trails/')&&<a class="text-link" href="/stories/culture-trails/">All cultural reading trails →</a>}</section>}
<style>.culture-connections{margin:55px 0;padding:38px 0;border-top:1px solid var(--line)}.trail-intro{max-width:700px;margin:20px 0 30px}.trail-grid{display:grid;gap:28px}.culture-trail{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1fr);background:var(--paper)}.culture-trail>img{width:100%;height:100%;max-height:480px;object-fit:cover;object-position:center 25%;min-height:250px}.culture-trail>img.trail-script{object-fit:contain;padding:35px;background:#e8dbc0}.culture-trail>div{padding:30px}.culture-trail h3{margin-bottom:18px}.trail-prompt{font-family:var(--serif);font-style:italic;color:var(--earth);margin-top:20px}.culture-trail nav{display:flex;flex-wrap:wrap;gap:12px 25px;margin-top:20px}.trail-note{font-size:13px;margin-top:22px;max-width:750px}.trail-credits{margin:25px 0;padding:20px;border-top:1px solid var(--line);font-size:14px}.trail-credits summary{cursor:pointer}.culture-connections details h3{font-size:23px;margin-top:22px}.culture-connections details p{font-size:14px}@media(max-width:700px){.culture-trail{grid-template-columns:1fr}.culture-trail>img{max-height:260px;min-height:0}.culture-trail>div{padding:23px}}</style>
