---
import ResponsiveImage from './ResponsiveImage.astro';
const {photo,variant=''}=Astro.props;
---
{photo&&<figure class:list={['destination-photo',variant]}>
  <ResponsiveImage src={photo.src} width={photo.width} height={photo.height} alt={photo.alt} loading="lazy" sizes="(max-width: 700px) 92vw, 80vw" />
  <figcaption>{photo.caption}</figcaption>
</figure>}
