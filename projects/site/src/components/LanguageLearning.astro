---
const {resource}=Astro.props;
---
<section class="language-learning" id="learning-shelf" aria-labelledby="learning-shelf-title" data-source-ids={resource.source_id}>
 <div><p class="eyebrow">On the reading shelf</p><h2 id="learning-shelf-title">{resource.title}</h2><p>{resource.description}</p><a class="text-link" href={resource.href}>Open the original learning booklet (PDF) ↗</a></div>
 <div class="language-book-note"><p class="eyebrow">A shared page</p><ul aria-label="Languages compared in the booklet">{resource.columns.map(c=><li>{c}</li>)}</ul><p>{resource.sample_note}</p><dl><div><dt>First edition</dt><dd>{resource.edition}</dd></div><div><dt>Published by</dt><dd>{resource.publisher}</dd></div><div><dt>Compiled by</dt><dd>{resource.compilers.join(', ')}</dd></div></dl></div>
</section>
<style>
.language-learning{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,5vw,64px);align-items:center;margin-block:48px;padding-block:36px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.language-learning p{max-width:55ch;line-height:1.8}.language-learning a{display:inline-block;padding-block:12px}.language-book-note{background:var(--paper);border-left:5px solid var(--earth);padding:clamp(24px,3vw,40px)}.language-book-note ul{list-style:none;padding:0;margin-block:24px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;color:var(--sea);font:clamp(18px,2vw,28px)/1.4 var(--serif)}.language-book-note li{border-bottom:2px solid var(--earth);padding-bottom:16px;overflow-wrap:anywhere}.language-book-note>p:not(.eyebrow){font-size:14px}.language-book-note dl{font-size:14px;line-height:1.8}.language-book-note dl>div{margin-top:14px}.language-book-note dt{font-weight:bold;color:var(--sea)}.language-book-note dd{margin:0}@media(max-width:800px){.language-learning{grid-template-columns:1fr}}
</style>
