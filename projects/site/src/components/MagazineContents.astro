---
const {links,label='On this page'}=Astro.props;
---
<nav class="mag-navigation story-contents-desktop" aria-label={label}>{links.map(link=><a href={link.href}>{link.label}</a>)}</nav>
<details class="story-contents-mobile"><summary>{label}</summary><nav aria-label={label}>{links.map(link=><a href={link.href}>{link.label}</a>)}</nav></details>
<style>
.story-contents-mobile{display:none}
@media(max-width:700px){.story-contents-desktop{display:none!important}.story-contents-mobile{display:block;margin:0 6%;border-block:1px solid var(--line);font-size:14px}.story-contents-mobile summary{cursor:pointer;min-height:48px;padding:14px 0;color:var(--sea);font-weight:600}.story-contents-mobile nav{display:flex;flex-direction:column;padding-bottom:12px}.story-contents-mobile a{display:flex;align-items:center;min-height:48px;padding:8px 0;text-underline-offset:4px}}
@media print{.story-contents-mobile,.story-contents-desktop{display:none!important}}
</style>
<script>
import {bindStoryContents} from '../lib/story-contents.mjs';
for(const details of document.querySelectorAll<HTMLDetailsElement>('.story-contents-mobile'))bindStoryContents(details,document);
</script>
