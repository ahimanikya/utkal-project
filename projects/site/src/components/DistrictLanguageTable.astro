---
import {count} from '../lib/language-atlas.mjs';
const {data,atlas}=Astro.props;
---
<p class="district-small">Denominator: {count(data.population)} people in {data.area.name} · {data.residence==='total'?'all areas':data.residence+' areas'}, 2011.</p>
<div class="district-table" role="region" tabindex="0" aria-label={data.area.name+' '+data.residence+' language groups'}><table><caption>Census language groups · mutually exclusive totals</caption><thead><tr><th scope="col">Group</th><th scope="col">People</th><th scope="col">Share</th></tr></thead><tbody>{data.groups.map(r=><tr><th scope="row"><a href={'/languages/atlas/?language='+r.code+'&residence='+data.residence}>{r.label}</a></th><td>{count(r.persons)}</td><td>{r.share}<span class="district-bar" aria-hidden="true"><i style={'width:'+r.persons/data.population*100+'%'}></i></span></td></tr>)}</tbody></table></div>
<details><summary>Look inside the groups: individual mother-tongue entries</summary><p>The entries below are already included in their parent groups above. Do not add both tables together. Only positive recorded counts for this residence category are shown; omission is not proof of an absence of speakers today. Residual group OTHERS has no subordinate entries here.</p><div class="district-table" tabindex="0" role="region" aria-label={data.area.name+' '+data.residence+' mother-tongue entries'}><table><caption>Individual entries · Census labels and parent classifications retained</caption><thead><tr><th scope="col">Entry / parent group</th><th scope="col">People</th><th scope="col">Male</th><th scope="col">Female</th><th scope="col">Share</th></tr></thead><tbody>{data.entries.map(r=><tr><th scope="row"><a href={'/languages/atlas/?language='+r.code+'&residence='+data.residence}>{r.label}</a><br/><small>Under {atlas.labels[r.parent].label} · C-16 row {r.sourceRow}</small></th><td>{count(r.persons)}</td><td>{count(r.males)}</td><td>{count(r.females)}</td><td>{r.share}</td></tr>)}</tbody></table></div></details>
