---
const {language='en', tone='colour'} = Astro.props;
const variant=language==='or'?'or':'en';
---
<span class:list={['brand','brand-'+variant]} lang={variant==='or'?'or':'en'}>
 <img class="brand-signature" src={'/assets/brand-v3/utkal-project-'+variant+'-'+(tone==='reverse'?'reverse':'colour')+'.svg'} alt={variant==='or'?'ଉତ୍କଳ':'Utkal Project'} width={variant==='or'?485:805} height="140"/>
</span>
