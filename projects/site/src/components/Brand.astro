---
const {language='en', tone='colour'} = Astro.props;
---
<span class:list={['brand', 'brand-'+language, {'brand-reverse':tone==='reverse'}]} lang={language==='or'?'or':'en'}>
  <img class="brand-mark" src="/assets/book-boat-v1.png" alt="" width="72" height="64" />
  {language==='or' ? <span class="brand-odia">ଉତ୍କଳ</span> : <span class="brand-english">Utkal Project</span>}
</span>
