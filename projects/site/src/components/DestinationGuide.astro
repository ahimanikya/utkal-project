---
import DestinationPhoto from './DestinationPhoto.astro';
const {destination:d}=Astro.props;
const groups=[
  {id:'things-to-do',eyebrow:'Make time for',title:d.headings.experiences,items:d.experiences},
  {id:'food',eyebrow:'At the table',title:d.headings.foods,items:d.foods,note:d.food_note},
  {id:'stay',eyebrow:'Choose your base',title:d.headings.bases,items:d.bases,note:d.stay_note}
];
---
<div class="destination-guide">
  <section id="plan-visit" class="destination-orientation" aria-labelledby="orientation-title" data-source-ids={d.orientation_sources.join(' ')}>
    <p class="eyebrow">Before you set out</p>
    <h2 id="orientation-title">{d.headings.orientation}</h2>
    <p>{d.orientation}</p>
    <p class="season-note" data-source-ids={d.season_sources.join(' ')}><strong>When to go.</strong> {d.season}</p>
  </section>
  {groups.map(group=><section class:list={['destination-section',{'food-section':group.id==='food'}]} id={group.id} aria-labelledby={group.id+'-title'}>
    <p class="eyebrow">{group.eyebrow}</p><h2 id={group.id+'-title'}>{group.title}</h2>
    {group.id==='food'&&<DestinationPhoto photo={d.visuals?.[d.food_image_ref]} variant="food-photo" />}
    <div class:list={['destination-cards',{'experience-cards':group.id==='things-to-do','one-visual':group.items.filter(item=>item.image_ref).length===1}]}>{group.items.map((item,index)=><article class:list={{'with-photo':!!item.image_ref}} id={item.id.replaceAll(':','-')} data-source-ids={item.sources.join(' ')}>
      {item.image_ref&&<DestinationPhoto photo={d.visuals?.[item.image_ref]} />}
      <span class="destination-number">0{index+1}</span>
      <div>{item.area&&<p class="eyebrow">{item.area}</p>}<h3>{item.title}</h3><p>{item.text}</p>{item.detail_href&&<a class="text-link detail-link" href={item.detail_href}>{group.id==='stay'?'Explore this stay area':'Explore this experience'} →</a>}</div>
    </article>)}</div>
    {group.note&&<p class="destination-note">{group.note}</p>}
  </section>)}
  <aside class="destination-plan"><h3>{d.planning.heading}</h3><p>{d.planning.text}</p></aside>
</div>
