---
import {isCoastalEdition} from '../data/edition';
import MagazineCover from './MagazineCover.astro';
import MagazineContents from './MagazineContents.astro';
import CultureCards from './CultureCards.astro';
import LanguageDirectory from './LanguageDirectory.astro';
import LanguageLearning from './LanguageLearning.astro';
import LanguageInvitation from './LanguageInvitation.astro';
import CultureConnections from './CultureConnections.astro';
import cultureTrails from '../../../../kb/research/voices/culture-trails.json';
import VoicesCredits from './VoicesCredits.astro';
import CultureOnward from './CultureOnward.astro';
import collection from '../../../../kb/research/voices/collection.json';
import '../styles/culture-magazine.css';
const {entry}=Astro.props,hero=collection.assets[entry.hero_asset],hub=!entry.path.includes('/');
const kind=entry.path.startsWith('languages')?'A living language':entry.path.startsWith('people')?'A literary life':'A world of words';
const start=hub&&entry.cards.length?'#reading-doors':'#'+entry.sections[0].id;
---
<div class:list={["utk-magazine","utk-magazine--culture",{"culture-script":hero?.kind==='script'}]}>
 <MagazineCover title={entry.title} eyebrow={entry.kicker} deck={[entry.lead]} photo={hero} caption={entry.hero_caption||hero?.caption} identity={entry.identity_panel} identityLabel={entry.identity_label||kind} identityNote={entry.identity_note||'A reading doorway, not a script specimen.'} saveId={hub?undefined:'reading:'+entry.path} startHref={start} startLabel={hub?'Find a reading doorway':'Follow the story'} footline="A place becomes richer when you listen to its voices."/>
 <MagazineContents links={[
 ...(hub&&entry.cards.length?[{href:'#reading-doors',label:'A place to begin'}]:[]),
 ...entry.sections.map(s=>({href:'#'+s.id,label:s.title})),
 ...(entry.learning_resource?[{href:'#learning-shelf',label:'Reading shelf'}]:[]),
 ...(entry.roster?[{href:'#more-voices',label:'More voices'}]:[]),
 ...(entry.language_contribution?[{href:'#share-a-voice',label:'Share a voice'}]:[])
 ]}/>
 <article class="mag-content">
  {hub&&(entry.path==='languages'?<LanguageDirectory entry={entry}/>:<CultureCards entry={entry}/>)}
  <div class="mag-article-chapters">{entry.sections.map((s,index)=><section id={s.id} class:list={['mag-reading-section',{'mag-reading-section--warm':index===1}]}><div><p class="eyebrow">{String(index+1).padStart(2,'0')} · {kind}</p><h2>{s.title}</h2></div><div>{s.paragraphs.map(p=><p data-source-ids={p.source_ids.join(' ')}>{p.text}</p>)}</div></section>)}</div>
  {!hub&&<CultureCards entry={entry}/>}
  {entry.learning_resource&&<LanguageLearning resource={entry.learning_resource}/>}
  {entry.roster&&<section id="more-voices" class="culture-roster"><p class="eyebrow">The collection will grow</p><h2>{entry.roster_heading}</h2><ul>{entry.roster.map(name=><li>{name}</li>)}</ul><p>{entry.roster_note}</p>{entry.roster_sources?.includes('scstrti')&&<a class="text-link" href={collection.sources.scstrti.url}>Browse SCSTRTI’s learning resources ↗</a>}</section>}
  {entry.external_links?.length>0&&<section class="culture-reading-links"><p class="eyebrow">Continue with the work</p>{entry.external_links.map(link=><a href={link.href}>{link.title} ↗</a>)}</section>}
  {!isCoastalEdition&&cultureTrails.trails.some(t=>t.show_on.includes('/'+entry.path+'/'))&&<details class="mag-disclosure"><summary>Places, languages and connected stories</summary><CultureConnections path={'/'+entry.path+'/'}/></details>}
  {entry.language_contribution&&<LanguageInvitation language={hub?'':entry.title}/>}
  <CultureOnward entry={entry}/>
  <VoicesCredits entry={entry}/><p class="mag-status">Editorial preview · awaiting Founder and language or literary review.</p>
 </article>
</div>
