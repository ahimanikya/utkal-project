<div class="page-share" data-page-share><button class="utk-button utk-button--secondary" type="button" data-share-button hidden>Share this page</button><p data-share-status role="status"></p><label data-share-fallback hidden>Page link<input readonly type="url" aria-label="Page link to copy"/></label></div>
<script>
const root=document.querySelector<HTMLElement>('[data-page-share]');
if(root){const button=root.querySelector<HTMLButtonElement>('[data-share-button]')!,status=root.querySelector<HTMLElement>('[data-share-status]')!,fallback=root.querySelector<HTMLElement>('[data-share-fallback]')!,input=fallback.querySelector<HTMLInputElement>('input')!;
 button.hidden=false;
 button.addEventListener('click',async()=>{const url=new URL(location.pathname,location.origin).href;button.disabled=true;status.textContent='';try{if(navigator.share){await navigator.share({title:document.title,url});status.textContent='Sharing opened.';}else{await navigator.clipboard.writeText(url);status.textContent='Page link copied.';}}catch(error){if(error instanceof DOMException&&error.name==='AbortError'){status.textContent='Sharing cancelled.';}else{fallback.hidden=false;input.value=url;input.focus();input.select();status.textContent='Copy the link below.';}}finally{button.disabled=false;}});
}
</script>
<style>.page-share{margin-top:20px}.page-share p{font-size:13px}.page-share label{display:block;margin-top:14px;font-size:14px}.page-share input{display:block;font:inherit;width:100%;max-width:34rem;padding:10px;background:var(--light);color:var(--sea);border:1px solid var(--line)}</style>
