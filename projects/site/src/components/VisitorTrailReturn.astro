---
import LocalContributionLinks from './LocalContributionLinks.astro';
import {storyTrails} from '../data/story-trails';
import {journeyCatalog} from '../data/journey-catalog';
const {path}=Astro.props;
const matching=storyTrails.filter(trail=>trail.href.split('#')[0]!==path&&trail.chapters.some(chapter=>chapter.ideas.some(id=>journeyCatalog.find(idea=>idea.id===id)?.href.split('#')[0]===path)));
---
{matching.map(trail=><aside class="wrap trail-return" aria-label="Continue this journey"><p><span class="eyebrow">Part of a bigger story</span><br/>{trail.return_text} <a class="text-link" href={trail.href}>Follow {trail.title} →</a></p><LocalContributionLinks page={path} kinds={trail.contribution_kinds}/></aside>)}
<style>.trail-return{padding-block:28px;border-top:1px solid var(--line)}.trail-return p{max-width:75ch}.trail-return a{display:inline-block;margin-top:12px}.trail-return .eyebrow{display:inline-block;margin-bottom:0}</style>
