---
import Shell from '../layouts/Shell.astro';
import SaveJourney from './SaveJourney.astro';
const {collection:c}=Astro.props;
const pictured=c.entries.filter(e=>e.photo),other=c.entries.filter(e=>!e.photo);
const photos=[...new Map(pictured.map(e=>[e.photo.src,e.photo])).values()];
---
<Shell title={c.title} description={c.lead} active="explore" wide><div class="wrap planning-collection">
<header class="page-head"><p class="eyebrow">{c.title} · {c.entries.length} ideas in the collection</p><h1>{c.headline}<br/><em class="highlight">{c.highlight}</em></h1><p class="lead">{c.lead}</p></header>
<nav class="planning-paths" aria-label="Plan your visit">{[['destinations','Places'],['food','Food'],['things-to-do','Things to do'],['stay-areas','Stay areas'],['journey','My journey']].map(([slug,label])=><a href={'/'+slug+'/'} aria-current={c.slug===slug?'page':undefined}>{label}</a>)}</nav>
<p class="notice">{c.note}</p>
{pictured.length>0&&<section aria-labelledby="pictured-heading"><h2 id="pictured-heading">Open a guide. Follow a story.</h2><div class="planning-cards">{pictured.map(i=><article class="utk-card planning-card"><figure><img src={i.photo.src} width={i.photo.width} height={i.photo.height} alt={i.photo.alt} style={{objectFit:i.photoFit}} loading="lazy"/><figcaption>{i.photo.caption}</figcaption></figure><div class="planning-copy"><p class="eyebrow">{i.area}</p><h3><a href={i.href}>{i.title} ↗</a></h3><p>{i.summary}</p><SaveJourney id={i.id}/></div></article>)}</div></section>}
{other.length>0&&<section class="planning-more" aria-labelledby="more-heading"><h2 id="more-heading">More ideas to research</h2><div class="planning-list">{other.map(i=><article><p class="eyebrow">{i.area}</p><h3><a href={i.href}>{i.title} ↗</a></h3><p>{i.summary}</p><SaveJourney id={i.id}/></article>)}</div></section>}
<section class="planning-questions"><div><p class="eyebrow">Make it useful</p><h2>Before you decide</h2></div><div><ul>{c.questions.map(q=><li>{q}</li>)}</ul><a class="button utk-button" href="/journey/#preparation">Open my journey checklist →</a></div></section>
<details class="utk-disclosure planning-credits"><summary>Sources, photographs & research notes</summary><p>These selections reuse the Utkal Project knowledge collection. Each linked entry retains its sources and checked date. Editorial review and local checks remain pending.</p><ul>{photos.map(p=><li><a href={p.source}>{p.caption||p.alt}</a> · {p.creator} · <a href={p.license_url}>{p.license}</a>. {p.changes}</li>)}</ul></details>
</div></Shell>
<style>.planning-collection{padding-bottom:50px}.planning-paths{display:flex;gap:12px 28px;flex-wrap:wrap;border-block:1px solid var(--line);padding:12px 0;margin:0 0 26px}.planning-paths a{min-height:44px;display:inline-flex;align-items:center}.planning-paths [aria-current]{color:var(--earth);text-decoration-thickness:2px}.planning-collection section>h2{margin:34px 0 26px;font-size:clamp(30px,3vw,44px)}.planning-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:26px}.planning-card{background:var(--paper);min-width:0;display:flex;flex-direction:column}.planning-card figure{margin:0}.planning-card img{display:block;width:100%;height:auto;aspect-ratio:1.6;object-fit:cover}.planning-card figcaption{font-size:12px;line-height:1.6;padding:14px 26px;border-bottom:1px solid var(--line)}.planning-copy{padding:26px;display:flex;flex-direction:column;flex:1}.planning-card h3,.planning-list h3{font-size:29px;margin:16px 0;overflow-wrap:anywhere}.planning-card h3 a,.planning-list h3 a{text-decoration:none}.planning-card h3 a:hover,.planning-list h3 a:hover{text-decoration:underline}.planning-copy :global(.journey-save),.planning-list :global(.journey-save){margin-top:auto;padding-top:20px}.planning-copy :global([data-active-journey]),.planning-list :global([data-active-journey]){font-size:12px}.planning-copy :global(button),.planning-list :global(button){white-space:normal;max-width:100%}.planning-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 40px}.planning-list article{display:flex;flex-direction:column;padding:26px 0;border-bottom:1px solid var(--line)}.planning-more{margin-top:50px}.planning-questions{display:grid;grid-template-columns:1fr 1.3fr;gap:40px;background:var(--paper);padding:32px;margin:44px 0}.planning-questions ul{padding-left:22px;margin-bottom:28px}.planning-questions li{margin:12px 0}.planning-credits{font-size:13px;overflow-wrap:anywhere}.planning-credits summary{padding:14px 0}.planning-credits li{margin:14px 0}@media(max-width:800px){.planning-list,.planning-questions{grid-template-columns:1fr}.planning-questions{padding:24px;gap:18px}}</style>
