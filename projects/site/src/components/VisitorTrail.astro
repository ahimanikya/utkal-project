---
import LocalContributionLinks from './LocalContributionLinks.astro';
import trail from '../../../../kb/research/destinations/stone-sea-trail.json';
import {journeyCatalog} from '../data/journey-catalog';
import {bookPhotos} from '../data/book-photos';
import ResponsiveImage from './ResponsiveImage.astro';
const {starter}=Astro.props;
const chapters=trail.chapters.map(chapter=>({...chapter,photo:bookPhotos[chapter.photo],ideas:chapter.ideas.map(id=>{const idea=journeyCatalog.find(item=>item.id===id);if(!idea)throw Error('Missing trail idea: '+id);return idea;})}));
---
<section id={starter.id} class="visitor-trail" aria-labelledby="visitor-trail-title">
<header class="trail-intro"><p class="eyebrow">One thread · three chapters · your own pace</p><h2 id="visitor-trail-title">Stone, sea <em class="highlight">and makers.</em></h2><p class="lead">{trail.intro}</p></header>
<div class="trail-chapters">{chapters.map((chapter,index)=><article class="trail-chapter" aria-labelledby={'trail-'+chapter.id}>
<figure><ResponsiveImage src={chapter.photo.src} alt={chapter.photo.alt} width={chapter.photo.width} height={chapter.photo.height} loading="lazy" sizes="(max-width: 760px) 92vw, 44vw"/><figcaption>{chapter.photo.caption}</figcaption></figure>
<div class="chapter-copy"><p class="eyebrow">0{index+1} · {chapter.place}</p><h3 id={'trail-'+chapter.id}>{chapter.title}</h3><p>{chapter.text}</p><ul class="chapter-links" aria-label={'Read about '+chapter.place}>{chapter.ideas.map(idea=><li><a class="text-link" href={idea.href}>{idea.title} →</a></li>)}</ul><p class="trail-prompt"><strong>Before you go</strong><br/>{chapter.prompt}</p></div>
</article>)}</div>
<div class="trail-prepare"><h3>Turn the thread into your journey.</h3><div class="preparation-grid">{trail.preparation.map(item=><div><h4>{item.title}</h4><p>{item.text}</p></div>)}</div><p>Save these {starter.ideas.length} ideas together, then choose dates, add notes and remove anything that does not fit. Every idea begins unscheduled. New journeys from this starter also carry these chapters into the downloadable tour book; choose the illustrated book to include photographs. Your existing journeys stay as they are.</p><div class="trail-action"><button type="button" class="button utk-button" data-journey-starter={starter.id} disabled aria-describedby={'starter-status-'+starter.id}>Start {starter.title}</button><p id={'starter-status-'+starter.id} class="starter-status" data-starter-status role="status" aria-live="polite"></p></div><p class="trail-alternative">Another turn in the story: <a href="/visit/places/dhauli/">read about Dhauli →</a></p></div>
<p><a class="text-link" href="/assets/stone-sea-local-verification.txt" download>Download the local verification pack →</a></p><LocalContributionLinks/>
</section>
<style>
.visitor-trail{margin:48px 0 80px;scroll-margin-top:30px}.trail-intro{max-width:820px;margin-bottom:40px}.trail-intro h2{font:clamp(38px,5vw,66px)/1.08 var(--serif);margin:16px 0 24px}.trail-chapters{display:grid;gap:48px}.trail-chapter{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:center;gap:clamp(24px,4vw,64px)}.trail-chapter figure{margin:0}.trail-chapter img{display:block;width:100%;height:auto;max-height:560px;object-fit:contain}.trail-chapter figcaption{font-size:12px;color:var(--muted);margin-top:12px;line-height:1.5}.chapter-copy{min-width:0}.chapter-copy h3,.trail-prepare h3{font:clamp(27px,3vw,38px)/1.18 var(--serif);margin:14px 0 22px}.chapter-copy>p{max-width:60ch}.chapter-links{list-style:none;padding:0;display:flex;flex-wrap:wrap;gap:8px 20px;margin:24px 0}.chapter-links a{display:inline-block;padding:8px 0}.trail-prompt{border-left:2px solid var(--earth);padding-left:18px;color:var(--muted);font-size:15px;line-height:1.65}.trail-prepare{margin-top:48px;padding:clamp(24px,4vw,48px);background:var(--paper);border:1px solid var(--line)}.preparation-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px;margin:24px 0}.preparation-grid h4{font-size:18px;margin:0 0 10px}.preparation-grid p{margin:0}.trail-action button{white-space:normal;text-align:left}.starter-status{margin:16px 0;min-height:24px}.trail-alternative{font-size:15px}@media(max-width:760px){.trail-chapter,.preparation-grid{grid-template-columns:1fr}.trail-chapters{gap:40px}.trail-chapter{gap:22px}.trail-intro{margin-bottom:28px}.visitor-trail{margin:32px 0 56px}.trail-action button{width:100%}}
</style>
