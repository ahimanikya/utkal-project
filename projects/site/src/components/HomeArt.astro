---
import ResponsiveImage from './ResponsiveImage.astro';
import {homeArt} from '../data/home-art';
---
<figure class="hero-media home-art" data-home-art>
  <div class="home-art-frame">
    {homeArt.map((scene, i) => <div data-scene data-key={scene.src} data-title={scene.title} data-theme={scene.theme} hidden={i !== 0}>
      <ResponsiveImage src={scene.src} width="1536" height="1024" alt={`Illustration. ${scene.alt}`} fetchpriority={i === 0 ? 'high' : 'low'} loading={i === 0 ? 'eager' : 'lazy'} />
    </div>)}
  </div>
  <figcaption><span data-caption>{homeArt[0].title}</span></figcaption>
</figure>



<style>
  .home-art-frame{overflow:hidden;aspect-ratio:3/2;background:var(--paper)}
  .home-art-frame [hidden]{display:none}
  .home-art-frame :global(img){width:100%;height:100%;aspect-ratio:3/2;object-fit:cover}
  .home-art figcaption{letter-spacing:0;text-transform:none;line-height:1.5}
</style>
