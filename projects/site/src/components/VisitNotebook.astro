---
import questions from '../../../../kb/research/destinations/visit-questions.json';
import data from '../../../../kb/research/destinations/visit-notebooks.json';
import {allowsPage} from '../data/edition';
import SaveJourney from './SaveJourney.astro';
const {path=Astro.url.pathname}=Astro.props;
const note=data.notebooks.find(n=>n.route===path);
const ask=questions.guides.find(g=>g.route===path);
---
{note&&<section class="visit-notebook" id="visit-notebook" aria-labelledby="visit-notebook-heading" data-notebook={note.save_id}>
 <header><p class="eyebrow">Make it your visit</p><h2 id="visit-notebook-heading">{note.title}</h2><p class="notebook-invitation">A few prompts for your own encounter.</p></header>
 <div class="notebook-copy"><p class="notebook-observe">{note.notice}</p><div class="notebook-prepare"><h3>Before you go</h3><p>{note.prepare}</p>{note.planning_help&&<><h3>Where to ask</h3><p>{note.planning_help.text} <a href={note.planning_help.url}>{note.planning_help.label} →</a></p></>}</div>
 <details class="utk-disclosure notebook-details"><summary>People, connections & a memory to keep</summary><h3>Connect with care</h3><p>{note.connect}</p><h3>Leave room for</h3><p>{note.pair.text}</p>{allowsPage(note.pair.href)&&<a href={note.pair.href}>{note.pair.label} →</a>}<h3>Bring home a memory</h3><p>{note.remember}</p></details>
 {ask&&<details class="utk-disclosure notebook-details visit-questions" id="visit-questions"><summary>Six questions to take with you</summary><p>Ask the people arranging your visit. These prompts help you prepare; they do not confirm local arrangements.</p><dl>{ask.questions.map(q=><div><dt>{q.heading}</dt><dd>{q.text}</dd></div>)}</dl><p>Save this idea, then add any useful question to your private reminders in <a href="/journey/#preparation">My journey</a>.</p></details>}
 <SaveJourney id={note.save_id} quiet/><p class="notebook-edit">Add your own day notes in <a href="/journey/">My journey</a>.</p></div>
</section>}
<style>
.visit-notebook{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:32px 7%;padding:40px 0;margin:44px 0;border-block:1px solid var(--line);scroll-margin-top:24px}.visit-notebook h2{font-size:clamp(32px,3.2vw,48px);line-height:1.2;max-width:17ch}.notebook-invitation{font:20px/1.6 var(--serif);margin-top:22px;max-width:28ch}.notebook-copy{min-width:0;max-width:68ch}.notebook-copy p{font-size:17px;line-height:1.8;margin:12px 0 22px}.notebook-observe{font-family:var(--serif);font-size:23px!important;color:var(--sea)}.notebook-prepare{border-left:3px solid var(--earth);padding-left:22px;margin:28px 0}.notebook-copy h3{font-size:22px;margin:20px 0 10px}.notebook-details{border-block:1px solid var(--line)}.notebook-details summary{min-height:48px;cursor:pointer;padding:14px 0;font-weight:600;color:var(--sea)}.visit-questions dl{margin:20px 0}.visit-questions dt{font-weight:650;color:var(--sea)}.visit-questions dd{margin:8px 0 24px;font-size:16px;line-height:1.8}.notebook-details a{min-height:44px;display:inline-flex;align-items:center}.notebook-copy .notebook-edit{font-size:14px}.notebook-copy :global(.journey-save){margin-bottom:12px}@media(max-width:750px){.visit-notebook{grid-template-columns:1fr;gap:16px;padding:30px 0}.visit-notebook h2{max-width:22ch}.notebook-invitation{margin-top:16px;max-width:100%}.notebook-copy{max-width:100%}}
</style>
