---
import VisitNotebook from './VisitNotebook.astro';
import editionCopy from '../../../../kb/research/destinations/coastal-edition-copy.json';
import {isCoastalEdition,allowsIdea,allowsPage} from '../data/edition';
import CollectionOnward from './CollectionOnward.astro';
import {collectionChapter} from '../data/reading-collection';
import MagazineCover from './MagazineCover.astro';
import SaveJourney from './SaveJourney.astro';
import CultureConnections from './CultureConnections.astro';
import cultureTrails from '../../../../kb/research/voices/culture-trails.json';
import data from '../../../../kb/research/destinations/regions.json';
import '../styles/region-magazine.css';
import connections from '../../../../kb/research/related-discoveries.json';
import {discoveryEntries} from '../data/discovery';
const r=structuredClone(Astro.props.region);
if(isCoastalEdition){
 r.items=r.items.filter(i=>allowsIdea(i.id));
 if(r.slug==='bhubaneswar'){
  r.orientation=editionCopy.bhubaneswar.orientation;
  r.sections.find(s=>s.id==='stories').paragraphs[0].text=editionCopy.bhubaneswar.story[0];
  r.sections.find(s=>s.id==='stories').paragraphs[1].text=editionCopy.bhubaneswar.story[1];
 }
}
const inCollection=collectionChapter(`/destinations/${r.slug}/`)>=0;
const hero=data.assets[r.hero],story=r.sections.find(s=>s.id==='stories');
const photos=[...new Set([r.hero,...r.items.map(i=>i.asset).filter(Boolean)])].map(id=>data.assets[id]);
const sourceIds=[...new Set([...r.source_ids,...r.facts.flatMap(f=>f.source_ids),...r.items.flatMap(i=>i.source_ids),...r.sections.flatMap(s=>s.paragraphs.flatMap(p=>p.source_ids)),...(r.visitor_notes||[]).flatMap(n=>n.source_ids)])];
const pictured=r.items.filter(i=>i.asset),other=r.items.filter(i=>!i.asset),next=data.regions.find(region=>region.slug===r.next);
const further=connections.links.filter(link=>link.from===`/destinations/${r.slug}/`&&!r.items.some(i=>i.link?.href===link.to)&&link.to!==`/destinations/${next.slug}/`).map(link=>({...link,title:discoveryEntries.find(e=>e.href===link.to)?.label||link.to}));
---
<div class="utk-magazine utk-magazine--region">
 <MagazineCover title={r.title} odia={r.odia} eyebrow={r.kicker} deck={[r.headline]} photo={hero} saveId={r.id} startHref="#stories" startLabel="Meet the place" footline={r.lead}/>
 <nav class="mag-navigation" aria-label="In this guide"><a href="#stories">The story</a><a href="#choose-your-stops">Places & experiences</a>{other.length>0&&<a href="#make-it-yours">Food & your own pace</a>}<a href="#before-you-go">Before you go</a></nav>
 <article class="mag-content">
  <section id="stories" class="mag-reading-section region-story-opening"><div><p class="eyebrow">01 · Find the thread</p><h2>{story.title}</h2></div><div>{story.paragraphs.map(p=><p data-source-ids={p.source_ids.join(' ')}>{p.text}</p>)}</div></section>
  <section id="choose-your-stops" class="mag-chapter"><div class="mag-section-heading"><div><p class="eyebrow">02 · A few places to begin</p><h2>Choose a few.<br/><em>Leave room to linger.</em></h2></div><p>{r.orientation}</p></div>
   <div class="region-picture-grid">{pictured.map(i=><article id={i.id.replaceAll(':','-')} class="mag-shore"><figure><img src={data.assets[i.asset].src} width={data.assets[i.asset].width} height={data.assets[i.asset].height} alt={data.assets[i.asset].alt} loading="lazy" class:list={{'region-contain':['script','fakir'].includes(i.asset)||data.assets[i.asset].fit==='contain'}}/><figcaption>{data.assets[i.asset].caption}</figcaption></figure><div><p class="eyebrow">{i.kind}</p><h3>{i.title}</h3><p>{i.summary}</p><p class="region-suggestion">{i.tip}</p>{i.link&&allowsPage(i.link.href)&&<a class="mag-detail-link" href={i.link.href}>{i.link.title} →</a>}<SaveJourney id={i.id} quiet/></div></article>)}</div>
  </section>
  {other.length>0&&<section id="make-it-yours" class="region-own-pace"><div><p class="eyebrow">03 · Make it yours</p><h2>A meal. A meeting.<br/><em>A little breathing room.</em></h2><p>Save the ideas that fit your interests. Choose the pace and the arrangements yourself.</p></div><div>{other.map(i=><article id={i.id.replaceAll(':','-')}><p class="eyebrow">{i.kind}</p><h3>{i.title}</h3><p>{i.summary}</p><p class="region-suggestion">{i.tip}</p>{i.link&&allowsPage(i.link.href)&&<a class="mag-detail-link" href={i.link.href}>{i.link.title} →</a>}<SaveJourney id={i.id} quiet/></article>)}</div></section>
  }
  {r.sections.filter(s=>s.id!=='stories').map(s=><section id={s.id} class="mag-reading-section"><div><p class="eyebrow">04 · Before you go</p><h2>{s.title}</h2></div><div>{s.paragraphs.map(p=><p data-source-ids={p.source_ids.join(' ')}>{p.text}</p>)}{s.id==='before-you-go'&&r.visitor_notes?.map(note=><div class="region-visitor-note" data-source-ids={note.source_ids.join(' ')}><h3>{note.heading}</h3><p>{note.text}</p></div>)}</div></section>)}
  <section id="at-a-glance" class="region-facts" aria-label="At a glance">{r.facts.map(f=><div><p class="eyebrow">{f.label}</p><p>{f.text}</p></div>)}</section>
  {!isCoastalEdition&&cultureTrails.trails.some(t=>t.show_on.includes(`/destinations/${r.slug}/`))&&<details class="mag-disclosure"><summary>Languages, literature and connected stories</summary><CultureConnections path={`/destinations/${r.slug}/`}/></details>}
  <VisitNotebook/>
  {inCollection?<CollectionOnward path={`/destinations/${r.slug}/`} extraLinks={[{href:`/destinations/${next.slug}/`,title:`Keep exploring · ${next.title}`},...further.map(link=>({href:link.to,title:link.title})),...(r.slug==='bhubaneswar'?[{href:'/journey-starters/#bhubaneswar-stone-painted-streets',title:'Start with stone and painted streets'}]:[]),...(r.journey_starter?[r.journey_starter]:[])]}/>:<><section class="region-onward"><div><p class="eyebrow">Take the story with you</p><h2>Your discoveries.<br/><em>Your own journey.</em></h2><p>Bring the places and ideas you saved together. Add days when you are ready.</p></div><div class="region-onward-links"><a class="utk-button" href="/journey/">Open my journey →</a>{r.slug==='bhubaneswar'&&<a class="text-link" href="/journey-starters/#bhubaneswar-stone-painted-streets">Start with stone and painted streets →</a>}{r.journey_starter&&<a class="text-link" href={r.journey_starter.href}>{r.journey_starter.title} →</a>}{r.coastal_starter&&<a class="text-link" href={r.coastal_starter.href}>{r.coastal_starter.title} →</a>}<a class="text-link" href={`/destinations/${next.slug}/`}>Keep exploring · {next.title} →</a>{further.map(link=><a class="text-link" href={link.to}>{link.title} →</a>)}</div></section></>}
  <details id="sources" class="mag-article-credits utk-disclosure"><summary>Sources, image credits & editorial notes</summary><p>Research and original editorial framing for Utkal Project, founded by Ahimanikya Satapathy. Suggestions are editorial ideas; visits, hosts and accommodation have not been field-checked for this preview.</p><ul>{sourceIds.map(id=><li><a href={data.sources[id].url}>{data.sources[id].title}</a><p>{data.sources[id].review}</p></li>)}</ul><h3>Image credits</h3>{photos.map(p=><p><a href={p.source}>{p.caption}</a> By {p.creator} · <a href={p.license_url}>{p.license}</a>. {p.changes}</p>)}<p>Still to research: detailed accessibility, inspected stays, invited local hosts, sourced oral histories, poems, songs and screen locations. <a href="/contribute/">Help improve this guide.</a></p></details>
  <p class="mag-status">Editorial preview · Reference check: {data.checked_on}. Photos show earlier visits. Opening dates, services and conditions can change.</p>
 </article>
</div>
