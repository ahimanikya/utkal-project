---
import connections from '../../../../kb/research/related-discoveries.json';
import {discoveryEntries} from '../data/discovery';
const {path}=Astro.props;
const cards=connections.links.filter(l=>l.from===path).map(l=>({...l,entry:discoveryEntries.find(e=>e.href===l.to)})).filter(c=>c.entry);
---
{cards.length>0&&<section class="wrap related-discoveries" aria-labelledby="related-discovery-heading"><p class="eyebrow">One discovery opens another</p><h2 id="related-discovery-heading">Keep your curiosity moving.</h2><div class="related-grid">{cards.map(({entry,reason})=><article class="utk-card">{entry.image&&<img src={entry.image.src} alt={entry.image.alt} width={entry.image.width} height={entry.image.height} loading="lazy"/>}<div><p class="eyebrow">{entry.category}</p><h3><a href={entry.href}>{entry.label} →</a></h3><p>{reason}</p></div></article>)}</div><p class="related-note">Ideas to read and research together. Arrange travel separately.</p><details><summary>Image credits</summary><ul>{cards.filter(c=>c.entry.image).map(({entry})=><li><a href={entry.image.source}>{entry.label}</a> · {entry.image.creator} · <a href={entry.image.license_url}>{entry.image.license}</a>. {entry.image.changes}</li>)}</ul></details></section>}
<style>.related-discoveries{padding-block:40px 60px;border-top:1px solid var(--line)}.related-discoveries h2{margin-bottom:30px}.related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:25px}.related-grid article{background:var(--paper);min-width:0}.related-grid img{width:100%;height:210px;object-fit:cover}.related-grid article>div{padding:25px}.related-grid h3{font-size:28px;margin-bottom:18px}.related-grid h3 a{text-decoration:none}.related-grid h3 a:hover{text-decoration:underline}.related-note{margin-top:22px;font-size:14px}.related-discoveries details{font-size:12px;margin-top:15px}.related-discoveries summary{cursor:pointer;min-height:44px;padding:10px 0}.related-discoveries li{margin:12px 0;overflow-wrap:anywhere}@media(max-width:700px){.related-grid{grid-template-columns:1fr}.related-grid img{height:auto;aspect-ratio:1.7}.related-grid article>div{padding:22px}}</style>
