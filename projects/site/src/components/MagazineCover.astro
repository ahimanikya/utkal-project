---
import SaveJourney from './SaveJourney.astro';
const {title,odia,eyebrow,deck,photo,caption,saveId,startHref,startLabel,footline,identity,identityLabel,identityNote}=Astro.props;
---
<header class:list={["mag-cover",{"mag-cover--contain":photo?.fit==='contain'}]}>
 <div class="mag-cover-copy"><p class="eyebrow">{eyebrow}</p><h1>{title}{odia&&<span lang="or">{odia}</span>}</h1><p class="mag-deck">{deck[0]}{deck[1]&&<><br/><em>{deck[1]}</em></>}</p></div>
 {photo?<figure id="story-image"><img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} fetchpriority="high"/><figcaption>{caption||photo.caption}</figcaption></figure>:<figure><div class="culture-identity"><p class="eyebrow">{identityLabel}</p><strong>{identity?.[0]||title}</strong><ul>{identity?.slice(1).map(line=><li>{line}</li>)}</ul><p>{identityNote}</p></div></figure>}
 <div class="mag-cover-actions"><a class="utk-button" href={startHref}>{startLabel} <span aria-hidden="true">↗</span></a>{saveId&&<SaveJourney id={saveId} quiet />}</div>
 <div class="mag-cover-foot"><p>{footline}</p><a href={startHref}>Begin the story ↓</a></div>
</header>
