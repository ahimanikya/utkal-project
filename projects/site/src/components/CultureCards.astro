---
import collection from '../../../../kb/research/voices/collection.json';
const {entry}=Astro.props,assets=collection.assets;
---
{entry.cards.length>0&&<section id="reading-doors" class="culture-doors"><p class="eyebrow">A place to begin</p><h2>{entry.card_heading}</h2><div class="culture-card-grid">{entry.cards.map(c=><article>{c.asset?<figure><a href={c.href} tabindex="-1" aria-hidden="true"><img src={assets[c.asset].src} width={assets[c.asset].width} height={assets[c.asset].height} alt="" loading="lazy"/></a></figure>:<div class="culture-reading-card" aria-hidden="true"><span>A reading doorway</span><strong>{c.title}</strong><span>{c.label||'Odia literature'}</span></div>}<div><h3><a href={c.href}>{c.title} ↗</a></h3><p>{c.text}</p></div></article>)}</div></section>}
