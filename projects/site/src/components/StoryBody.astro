---
import DestinationPhoto from './DestinationPhoto.astro';
const {story,culture=[],culturePhoto,referencePhotos}=Astro.props;
---
<div class:list={['story-flow',{'reference-story':!!referencePhotos}]}>
  <section id="poems-songs" class="story-voice" aria-labelledby="voice-title" data-source-ids={story.voice?.sources.join(" ")}>
    {referencePhotos&&<DestinationPhoto photo={referencePhotos.mangalajodi} variant="story-chapter-photo" />}
    <p class="eyebrow">Literature & living culture</p>
    <h2 id="voice-title">{story.voice?.heading??story.culture_heading}</h2>
    {story.voice?<><blockquote>
      <p lang={story.voice.language} class="odia-verse">{story.voice.original}</p>
      <p class="verse-translation">{story.voice.translation}</p>
      <footer>{story.voice.author} · <cite>{story.voice.work}</cite></footer>
    </blockquote><p>{story.voice.context}</p></>:<p>{story.culture_intro}</p>}
    <DestinationPhoto photo={culturePhoto} variant="culture-photo" />
    {referencePhotos?<details class="culture-reading"><summary>Poems and songs to explore</summary>    <div class="culture-list">{culture.map(work=><article id={work.id.replaceAll(':','-')} data-source-ids={work.sources.join(' ')}>
      <p class="eyebrow">{work.type==='song'?'Listen':work.type==='performance'?'Experience':'Read'}</p>
      <h3>{work.title}</h3><p>{work.text}</p>
      <a class="text-link" href={work.url}>{work.link_label} ↗</a>
    </article>)}</div></details>:<>    <div class="culture-list">{culture.map(work=><article id={work.id.replaceAll(':','-')} data-source-ids={work.sources.join(' ')}>
      <p class="eyebrow">{work.type==='song'?'Listen':work.type==='performance'?'Experience':'Read'}</p>
      <h3>{work.title}</h3><p>{work.text}</p>
      <a class="text-link" href={work.url}>{work.link_label} ↗</a>
    </article>)}</div></>}
  </section>
  {story.belief&&<section class="story-belief" id="local-belief" aria-labelledby="belief-title" data-source-ids={story.belief.sources.join(" ")}>
    {referencePhotos&&<DestinationPhoto photo={referencePhotos.kalijai} variant="story-chapter-photo" />}
    <p class="eyebrow">{story.belief.label}</p>
    <h2 id="belief-title">{story.belief.heading}</h2>
    <p>{story.belief.text}</p>
    <p class="belief-note">{story.belief.qualification}</p>
  </section>}
  {story.surprise&&<section class:list={['story-surprise',{'utk-inverse':!referencePhotos}]} id={story.surprise.id??'ecology'} aria-labelledby="surprise-title" data-source-ids={story.surprise.sources.join(" ")}>
    <p class="eyebrow">Look a little closer</p>
    <h2 id="surprise-title">{story.surprise.heading}</h2>
    <dl class="story-metrics">{story.surprise.metrics.map(metric=><div><dt>{metric.label}</dt><dd>{metric.value}</dd></div>)}</dl>
    <p>{story.surprise.text}</p>
    <details><summary>{story.surprise.reveal_label}</summary><p>{story.surprise.reveal}</p></details>
  </section>}
  {!referencePhotos&&<aside class="story-play" aria-labelledby="play-title">
    <p class="eyebrow">A small moment of your own</p>
    <h2 id="play-title">{story.invitation.heading}</h2>
    <p>{story.invitation.text}</p>
    <a class="text-link" href="#story-image">Look again ↑</a>
  </aside>}
</div>

<style is:global>
.destination-wide .reference-story{display:block;max-width:1120px;margin:0 auto;padding:0}
.destination-wide .reference-story .story-voice,.destination-wide .reference-story .story-belief{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);column-gap:clamp(28px,4vw,64px);padding:0;margin:0 0 64px;border:0;background:transparent;align-items:start}
.reference-story .story-voice>.story-chapter-photo,.reference-story .story-belief>.story-chapter-photo{grid-column:1;grid-row:1/7;margin:0}
.reference-story .story-voice>:not(.story-chapter-photo),.reference-story .story-belief>:not(.story-chapter-photo){grid-column:2}
.reference-story h2{font-size:clamp(28px,2.5vw,38px);margin:12px 0 24px}
.reference-story .story-voice blockquote{margin:0;padding:0;border:0;background:transparent}
.reference-story .story-chapter-photo img{width:100%;height:auto;aspect-ratio:1.05;object-fit:cover}
.reference-story .culture-reading{margin-top:24px;border-top:1px solid var(--line);padding-top:16px;font-size:16px}.reference-story .culture-reading summary{cursor:pointer;color:var(--sea);padding-block:8px}
.reference-story .culture-list{display:block;margin:16px 0}.reference-story .culture-list article{margin:0;padding:20px 0}
.destination-wide .reference-story .story-surprise{max-width:760px;margin:0 auto 56px;padding:28px 0;background:transparent;color:var(--ink);border-block:1px solid var(--line)}
body.utk .reference-story .story-surprise :is(h2,h3,summary,dd){color:var(--sea)}body.utk .reference-story .story-surprise .eyebrow{color:var(--earth)}
.reference-story .story-metrics{margin:24px 0}.reference-story .story-metrics dd{font-size:36px}.reference-story .story-surprise>p{max-width:68ch}
body.utk .reference-story .story-voice .odia-verse{font-size:clamp(22px,1.6vw,26px)}body.utk .reference-story .story-voice .verse-translation{font-size:21px}
@media(max-width:900px){.destination-wide .reference-story .story-voice,.destination-wide .reference-story .story-belief{display:block;margin-bottom:44px}.reference-story .story-voice>.story-chapter-photo,.reference-story .story-belief>.story-chapter-photo{margin-bottom:24px}.reference-story .story-chapter-photo img{aspect-ratio:1.6}}
</style>
