---
import Shell from '../../layouts/Shell.astro';
import entries from '../../data/selected.json';
export function getStaticPaths(){return entries.map(entry=>({params:{slug:entry.slug},props:{entry}}));}
const {entry}=Astro.props;
const sourceNumber=(id:string)=>entry.sources.findIndex(source=>source.id===id)+1;
---
<Shell title={entry.label} description={entry.dek} active="explore">
  <div class="wrap">
    <div class="page-head">
      <p class="breadcrumb"><a href="/explore/">The collection</a> / {entry.category}</p>
      <p class="eyebrow">Research note · {entry.category}</p>
      <h1>{entry.label}</h1>
      <p class="lead">{entry.dek}</p>
    </div>
    <article class="knowledge">
      <p class="notice">Editorial draft. Source check completed; awaiting review by the Founder & Editor-in-Chief.</p>
      {entry.paragraphs.map(paragraph=>
        <p class="knowledge-text">
          {paragraph.text}
          {paragraph.sources.map(id=>
            <a class="citation" href={'#source-'+id} aria-label={'Source '+sourceNumber(id)+': '+entry.sources.find(source=>source.id===id)?.title}>[{sourceNumber(id)}]</a>
          )}
        </p>
      )}
      <h2 style="font-size:30px;margin-bottom:20px">Follow the sources</h2>
      <ol class="source-list">
        {entry.sources.map(source=>
          <li id={'source-'+source.id}>
            <a href={source.resource}>{source.title} ↗</a>
            {source.inspection&&<p class="source-inspection">{source.inspection}</p>}
          </li>
        )}
      </ol>
      <p class="source-credit">Prepared from the Utkal Project knowledge base: {entry.path}. Source credit belongs to the authors and institutions linked above. Founder & Editor-in-Chief: Ahimanikya Satapathy. Research assembled with AI assistance; source verification is not an independent scholarly review.</p>
      <div class="actions">
        <a class="text-link" href="/explore/">← Back to the collection</a>
        <a class="text-link" href="/contribute/">Help this entry grow ↗</a>
      </div>
    </article>
  </div>
</Shell>
