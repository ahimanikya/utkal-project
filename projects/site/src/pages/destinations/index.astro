---
import PlanningPaths from '../../components/PlanningPaths.astro';
import Shell from '../../layouts/Shell.astro';
import DestinationCards from '../../components/DestinationCards.astro';
import {destinationGuides} from '../../data/destination-directory';
---
<Shell title="Destinations in Odisha" description="Choose a city, a coast or forest country. Browse Odisha destination guides, then connect food, experiences and a place to base yourself." active="explore" wide related={false}><div class="wrap"><header class="page-head"><p class="eyebrow">{destinationGuides.length} starting points · a growing collection</p><h1>A place to pause.<br/><em class="highlight">A story to follow.</em></h1><p class="lead">Find your way into Odisha through its cities, shores and landscapes. Open a guide for the places, food and stories to explore.</p><div class="actions"><a class="button utk-button" href="/journey-starters/">Find a journey starter →</a><a class="text-link" href="/explore/">Search the whole collection →</a></div></header><PlanningPaths current="/destinations/"/><section class="section" aria-label="Destination guides"><h2 class="directory-heading">Find a place that draws you in.</h2><DestinationCards guides={destinationGuides}/></section><p class="notice">A preview collection, growing one place at a time. Guides contain research suggestions; check access, transport and opening arrangements before travel.</p></div></Shell>

<style>.directory-heading{font-size:clamp(30px,3vw,44px);margin-bottom:28px}</style>
