---
import entry from '../../data/entry.json';
import site from '../../data/site.json';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="description" content={entry.summary} />
  <title>{entry.title} · {site.name}</title>
  <link rel="stylesheet" href="/assets/brand-tokens.css" />
</head>
<body>
  <a class="skip" href="#article">Skip to article</a>
  <header class="masthead">
    <a class="wordmark" href="/" aria-label={site.name + ' home'}>{site.name}<small>{site.tagline}</small></a>
    <a class="header-link" href="#sources">Explore the sources <span aria-hidden="true">↗</span></a>
  </header>
  <main id="article" tabindex="-1">
    <div class="draft"><span class="dot" aria-hidden="true"></span> Editorial preview <span class="draft-detail">· Draft awaiting Founder review</span></div>
    <section class="hero" aria-labelledby="entry-title">
      <div>
        <p class="eyebrow">{entry.category}</p>
        <h1 id="entry-title">Samanta<br />Chandrasekhar</h1>
        <p class="alternate">Also known as {entry.alternateName}</p>
        <p class="standfirst">{entry.summary}</p>
        <p class="place">{entry.place}</p>
      </div>
      <div class="sky" aria-hidden="true">
        <svg viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="200" cy="200" r="161"/><circle cx="200" cy="200" r="118"/><circle cx="200" cy="200" r="74"/>
          <ellipse cx="200" cy="200" rx="161" ry="55" transform="rotate(-35 200 200)" />
          <path d="M38 200H362M200 39V361M86 86L314 314M86 314L314 86" />
          <circle class="star" cx="200" cy="200" r="8"/><circle class="star" cx="288" cy="99" r="4"/><circle class="star" cx="93" cy="270" r="5"/>
          <path class="bright" d="M322 240V258M313 249H331M106 91V103M100 97H112"/>
        </svg>
        <p>Observe. Question. Understand.</p>
        <small>Decorative sky study</small>
      </div>
    </section>
    <div class="reading-layout">
      <aside class="contents" aria-label="On this page">
        <p class="eyebrow">In this entry</p>
        <nav>{entry.sections.map((section, i) => <a href={'#'+section.id}><span>0{i+1}</span>{section.title}</a>)}<a href="#sources"><span>04</span>Sources & reading</a><a href="#credits"><span>05</span>Credit & review</a></nav>
        <div class="context"><span class="eyebrow">Knowledge grows</span><p>This first entry makes its sources and open questions visible. New evidence can improve the next version.</p></div>
      </aside>
      <article>
        {entry.sections.map((section) => <section id={section.id} class:list={['article-section', {uncertainty: section.id === 'reading-with-care'}]}>
          <h2>{section.title}</h2>
          {section.paragraphs.map(p => <p>{p.text} {p.sources.map(id => <a class="citation" href={'#'+id} aria-label={'Read source '+id}>[{id.slice(1)}]</a>)}</p>)}
        </section>)}
        <section id="sources" class="article-section sources">
          <p class="eyebrow">Follow the evidence</p><h2>Sources & further reading</h2>
          <p class="section-intro">What we consulted, and how far we could verify it.</p>
          <ol>{entry.sources.map(s => <li id={s.id}><a href={s.url}>{s.title} <span aria-hidden="true">↗</span></a><p>{s.author}<br/><span>{s.publisher}</span></p><details><summary>What we reviewed</summary><p>{s.review}</p></details></li>)}</ol>
        </section>
        <section id="credits" class="article-section credits">
          <p class="eyebrow">Made with care · Open to correction</p><h2>Credit & review</h2>
          <p>Prepared for <strong>{entry.credit.initiative}</strong>. Founder & Editor-in-Chief: <strong>{entry.credit.founder}</strong>.</p>
          <p class="review-status">Editorial review: pending</p>
          <details><summary>Research & design notes</summary><p>Prepared with AI-assisted research and design tools. Source authors retain credit for their work; the source notes describe what was reviewed and what remains uncertain.</p><p>The sky ornament is decorative artwork, not a reconstruction of a historical instrument. Editorial review is pending; no scholarly endorsement or fieldwork is claimed.</p></details>
          <p class="contribution">Contribution channels are being prepared. This preview does not accept submissions yet.</p>
        </section>
      </article>
    </div>
  </main>
  <footer><span class="wordmark">{site.name}</span><p>{site.tagline}</p><small>{entry.id} · Editorial prototype · No public reuse licence selected</small></footer>
</body>
</html>
<style>
  :global(*){box-sizing:border-box} :global(html){scroll-behavior:smooth;scroll-padding-top:24px} :global(body){margin:0;background:var(--utp-limewash);color:var(--utp-earth-ink);font:17px/1.7 system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif} :global(a){color:var(--utp-nila-sagara);text-underline-offset:4px} :global(a:hover){color:var(--utp-mankada-pathara)} :global(:focus-visible){outline:3px solid var(--utp-mankada-pathara);outline-offset:5px} :global(h1),:global(h2){color:var(--utp-nila-sagara);font-family:Georgia,'Times New Roman',serif;font-weight:400;line-height:1.12} :global(h2){font-size:34px;margin:0 0 24px} :global(p){margin:0 0 22px} .skip{position:absolute;top:-80px;left:16px;background:#fff;padding:8px 16px;z-index:10}.skip:focus{top:8px}.masthead{max-width:1260px;margin:auto;padding:30px 52px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #302e2826;gap:20px}.wordmark{font:32px/1.2 Georgia,serif;color:var(--utp-nila-sagara);text-decoration:none;white-space:nowrap}.wordmark span{color:var(--utp-sukha-ghasi-straw)}.wordmark small{display:block;font:14px/1.5 system-ui,sans-serif;letter-spacing:.01em;text-transform:none;color:#57504a;margin-top:10px;white-space:normal}.header-link{font-size:13px}main{max-width:1260px;margin:auto;padding:0 52px}.draft{font-size:12px;letter-spacing:.025em;padding:22px 0;color:#60564d;display:flex;gap:8px;align-items:center}.dot{width:7px;height:7px;background:var(--utp-mankada-pathara);border-radius:50%;flex-shrink:0}.hero{display:grid;grid-template-columns:1.5fr 1fr;gap:40px;align-items:center;padding:38px 0 72px;border-bottom:1px solid #302e2826}.eyebrow{font:11px/1.5 system-ui,sans-serif;letter-spacing:.16em;text-transform:uppercase;font-weight:650;color:var(--utp-mankada-pathara);margin-bottom:22px}h1{font-size:clamp(46px,5.6vw,76px);letter-spacing:-.04em;margin:0 0 20px}.alternate{font:italic 20px/1.5 Georgia,serif;color:#66594c}.standfirst{font:23px/1.55 Georgia,serif;max-width:620px;margin-top:30px}.place{font-size:12px;letter-spacing:.09em;text-transform:uppercase;color:var(--utp-sukha-ghasi-olive);margin-top:30px;margin-bottom:0}.sky{background:var(--utp-nila-sagara);color:var(--utp-limewash);aspect-ratio:4/5;display:flex;flex-direction:column;justify-content:center;align-items:center;border-radius:180px 180px 4px 4px;padding:18px}.sky svg{width:100%;stroke:#e6d6be;stroke-opacity:.45;stroke-width:1}.sky .star{fill:var(--utp-sukha-ghasi-straw);stroke:none}.sky .bright{stroke:var(--utp-sukha-ghasi-straw);stroke-opacity:1}.sky p{font:italic 17px Georgia,serif;margin:0 0 12px}.sky small{font-size:9px;letter-spacing:.15em;text-transform:uppercase;opacity:.7}.reading-layout{display:grid;grid-template-columns:230px minmax(0,1fr);gap:85px;padding-top:64px}.contents nav{display:flex;flex-direction:column;gap:16px}.contents nav a{font-size:13px;text-decoration:none;display:flex;gap:14px;line-height:1.5}.contents nav a span{font-size:10px;color:var(--utp-mankada-pathara);padding-top:3px}.context{border-top:1px solid #302e2826;margin-top:35px;padding-top:25px}.context p{font:italic 17px/1.6 Georgia,serif;color:#60564d;margin-top:12px}.article-section{margin-bottom:56px;max-width:740px}.article-section p{font-size:17px;line-height:1.85}.citation{font:12px system-ui,sans-serif;text-decoration:none;font-weight:600;white-space:nowrap;padding:3px}.uncertainty{border-left:3px solid var(--utp-sukha-ghasi-straw);padding:4px 0 1px 26px}.uncertainty h2{font-size:30px}.section-intro{color:#60564d}.sources{border-top:1px solid #302e2826;padding-top:40px}.sources ol{padding-left:25px}.sources li{padding:0 0 25px 10px;scroll-margin-top:20px}.sources li::marker{font-size:12px;color:var(--utp-mankada-pathara)}.sources li>a{font:20px/1.4 Georgia,serif}.sources li p{font-size:13px;line-height:1.7;margin:12px 0}.sources li p span{color:#60564d}details{font-size:13px}summary{cursor:pointer;color:var(--utp-nila-sagara);text-decoration:underline;text-underline-offset:4px;padding:4px 0}details[open]{padding-bottom:8px}details p{margin:15px 0!important;font-size:14px!important}.credits{padding:32px;background:#ebe0d0;border-radius:4px}.credits h2{font-size:30px}.credits p{font-size:15px}.credits ul{padding-left:20px}.credits li{margin-bottom:7px}.review-status{font-weight:600;color:var(--utp-mankada-pathara)}.contribution{border-top:1px solid #302e2826;padding-top:20px;margin-top:24px!important;color:#60564d;font-size:13px!important}footer{max-width:1260px;margin:25px auto 0;padding:42px 52px;border-top:1px solid #302e2826}footer .wordmark{font-size:25px}footer p{font:italic 18px Georgia,serif;margin:20px 0}footer small{font-size:10px;letter-spacing:.05em;color:#60564d}@media(max-width:900px){.masthead,main,footer{padding-left:28px;padding-right:28px}.hero{gap:24px}.reading-layout{grid-template-columns:180px minmax(0,1fr);gap:32px}.sky p{font-size:13px}.standfirst{font-size:21px}}@media(max-width:650px){.masthead{padding-top:24px;padding-bottom:24px}.wordmark{font-size:26px}.wordmark small{font-size:12px;letter-spacing:0}.header-link{display:none}.draft{font-size:10px;flex-wrap:wrap;gap:5px}.hero{grid-template-columns:1fr;padding:24px 0 40px;gap:32px}.hero h1{font-size:47px}.sky{aspect-ratio:1.6;border-radius:120px 120px 4px 4px;overflow:hidden;position:relative;padding:18px}.sky svg{position:absolute;width:240px;right:-40px;top:-25px;opacity:.55}.sky p,.sky small{align-self:flex-start;position:relative}.sky p{font-size:17px}.standfirst{font-size:22px}.reading-layout{grid-template-columns:1fr;gap:32px;padding-top:32px}.contents nav{display:grid;grid-template-columns:1fr 1fr;gap:12px}.contents nav a{font-size:12px}.context{display:none}.contents{padding-bottom:28px;border-bottom:1px solid #302e2826}.contents .eyebrow{margin-bottom:16px}h2{font-size:30px}.article-section p{font-size:16px}.article-section{margin-bottom:40px}.uncertainty{padding-left:18px}.credits{padding:24px}.credits p{font-size:14px}footer{padding-top:32px;padding-bottom:32px}}@media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}}

main:focus{outline:none}.hero>div{min-width:0}.contents nav a,.header-link,summary{min-height:44px;align-items:center}.contents nav a{font-size:14px}summary{padding-block:10px}
@media(max-width:650px){.hero h1{font-size:clamp(36px,11vw,47px);overflow-wrap:break-word}.sky{min-width:0}.header-link{display:inline-flex}.masthead{flex-wrap:wrap}.contents nav{grid-template-columns:1fr}}
</style>
