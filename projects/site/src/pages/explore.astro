---
import {isCoastalEdition} from '../data/edition';
import Shell from '../layouts/Shell.astro';
import {discoveryEntries as entries,discoveryTopics as topics,discoveryRegions as regions} from '../data/discovery';
const images=[...new Map(entries.filter(e=>e.image).map(e=>[e.image.src,e.image])).values()];
---
<Shell title="Explore the collection" active="explore" wide><div class="wrap explore-page"><div class="page-head"><p class="eyebrow">The collection · preview edition</p><h1>Where will curiosity<br/>take you?</h1><p class="lead">A shore, a story, a taste of somewhere. Choose a subject and an area, then follow what draws you in.</p></div>
{isCoastalEdition?<div class="actions" style="margin-bottom:32px"><a class="text-link" href="/destinations/bhubaneswar/">Begin the five stories →</a><a class="text-link" href="/food/puri-coast/">Food by the coast →</a><a class="text-link" href="/visit/stays/puri-coast/">Compare coastal bases →</a><a class="text-link" href="/journey-starters/">Start your journey →</a></div>:<><div class="actions" style="margin-bottom:32px"><a class="text-link" href="/destinations/">Browse destination guides →</a><a class="text-link" href="/food/">Food →</a><a class="text-link" href="/things-to-do/">Things to do →</a><a class="text-link" href="/stay-areas/">Stay areas →</a><a class="text-link" href="/journey-starters/">Try a journey starter →</a></div></>}
<form class="filter-form" id="search-form" role="search" aria-label="Search Utkal collection"><label for="search" class="utk-field">Search the collection<input id="search" name="q" type="search" maxlength="200" placeholder={isCoastalEdition?'Try Konark, Puri or food':'Try Chilika, textiles or Samanta'} autocomplete="off"/></label><label for="region" class="utk-field">Area or place connection<select id="region" name="region">{regions.map(r=><option value={r}>{r==='All'?'All areas':r}</option>)}</select></label><label class="utk-field" for="sort">Order<select id="sort" name="sort"><option value="collection">Collection order</option><option value="title">Name A–Z</option></select></label><button class="button utk-button" type="submit">Search <span aria-hidden="true">↗</span></button></form>
<nav class="filters" aria-label="Filter by topic">{topics.map(topic=><a href={topic==='All'?'/explore/':'/explore/?topic='+encodeURIComponent(topic)} data-topic={topic} aria-current={topic==='All'?'true':undefined}>{topic}</a>)}</nav><div class="results-heading"><p class="result-count" id="result-count" tabindex="-1" role="status" aria-live="polite">{entries.length} entries in this preview</p><a href="/explore/" id="clear-filters">Clear filters</a></div><noscript><p class="notice">All entries are shown below. Enable JavaScript to combine search and filters.</p></noscript>
<div class="notes-grid search-results" id="results" role="region" aria-label="Matching collection entries">{entries.map(e=><article class="note-card utk-card" data-entry={JSON.stringify({label:e.label,dek:e.dek,category:e.category,regions:e.regions,aliases:e.aliases})}>{e.image&&<figure class="explore-figure"><img class:list={['explore-photo',{'explore-portrait':e.category==='People'}]} src={e.image.src} alt={e.image.alt} width={e.image.width} height={e.image.height} loading="lazy"/></figure>}<p class="eyebrow">{e.category} · {e.regions.join(' / ')}</p><h2 class="entry-title"><a href={e.href}>{e.label}</a></h2><p>{e.dek}</p><a href={e.href} class="card-bottom"><span>Read the entry</span><span aria-hidden="true">↗</span></a></article>)}</div><p class="empty" id="empty-results" hidden>No matching entries yet. Try another area or <a href="/explore/">clear the filters</a>. A missing result means our collection is still growing—<a href="/contribute/?new=1">suggest a subject</a>.</p><details class="explore-credits utk-disclosure"><summary>Collection image credits</summary><ul>{images.map(p=><li><a href={p.source}>{p.caption||p.alt}</a> · {p.creator} · <a href={p.license_url}>{p.license}</a>. {p.changes}</li>)}</ul></details><div class="section"><p class="notice">These are editorial previews. Area filters indicate a place or cultural connection, not a verified route or a language’s full geographic range.</p></div></div></Shell>
<script>
 import {boundedQuery} from '../lib/search.mjs';
 import {matchesDiscovery,discoveryQuery,sortDiscoveries} from '../lib/discovery.mjs';
 const input=document.querySelector<HTMLInputElement>('#search')!,region=document.querySelector<HTMLSelectElement>('#region')!,sort=document.querySelector<HTMLSelectElement>('#sort')!;
 const cards=[...document.querySelectorAll<HTMLElement>('#results article')].map(card=>({card,entry:JSON.parse(card.dataset.entry!)}));
 const topics=[...document.querySelectorAll<HTMLAnchorElement>('[data-topic]')];let topic='All';
 function readURL(){const p=new URLSearchParams(location.search);input.value=boundedQuery(p.get('q'));sort.value=p.get('sort')==='title'?'title':'collection';topic=topics.some(t=>t.dataset.topic===p.get('topic'))?p.get('topic')!:'All';region.value=[...region.options].some(o=>o.value===p.get('region'))?p.get('region')!:'All';}
 function filter(updateURL=true){const ordered=sortDiscoveries(cards.map(v=>({...v.entry,href:v.card.querySelector('a').getAttribute('href'),card:v.card})),sort.value);for(const row of ordered)document.querySelector('#results')!.append(row.card);const state={q:input.value,topic,region:region.value,sort:sort.value};let count=0;for(const {card,entry} of cards){card.hidden=!matchesDiscovery(entry,state);if(!card.hidden)count++;}for(const t of topics){if(t.dataset.topic===topic)t.setAttribute('aria-current','true');else t.removeAttribute('aria-current');const query=discoveryQuery({...state,topic:t.dataset.topic});t.href='/explore/'+(query?'?'+query:'');}document.querySelector('#result-count')!.textContent=`${count} ${count===1?'entry':'entries'} found`;document.querySelector<HTMLElement>('#empty-results')!.hidden=count>0;if(updateURL){const q=discoveryQuery(state);history.replaceState(null,'',location.pathname+(q?'?'+q:''));}}
 document.querySelector('#clear-filters')!.addEventListener('click',e=>{e.preventDefault();input.value='';region.value='All';sort.value='collection';topic='All';filter();input.focus();});
 readURL();filter(false);input.addEventListener('input',()=>filter());region.addEventListener('change',()=>filter());sort.addEventListener('change',()=>filter());document.querySelector('#search-form')!.addEventListener('submit',e=>{e.preventDefault();filter();document.querySelector<HTMLElement>('#result-count')!.focus();});topics.forEach(t=>t.addEventListener('click',e=>{if(e.ctrlKey||e.metaKey||e.shiftKey||e.altKey)return;e.preventDefault();topic=t.dataset.topic!;filter();}));window.addEventListener('popstate',()=>{readURL();filter(false);});
</script>
<style>.explore-page .page-head{max-width:1000px;padding-bottom:24px}.explore-page .search-results{gap:44px 32px}.explore-page .note-card{border:0;padding:0;background:transparent;display:flex;flex-direction:column}.explore-page .note-card .card-bottom{margin-top:auto;padding-block:18px}.explore-page .explore-figure{background:var(--paper)}.explore-page .explore-photo{display:block;height:auto;aspect-ratio:1.45}.explore-page .explore-photo.explore-portrait{object-fit:contain}.explore-page .filter-form{padding:24px;background:var(--paper);border-top:2px solid var(--earth);gap:20px}.explore-page .entry-title{font-size:34px}.explore-page .entry-title a{text-decoration:none}.explore-page .entry-title a:hover{text-decoration:underline}.explore-page .note-card>p:not(.eyebrow){line-height:1.7;font-size:16px}.explore-page .filters{margin-top:24px}@media(max-width:950px){.explore-page .filter-form{flex-wrap:wrap}.explore-page .filter-form label:first-child{flex-basis:100%}}.explore-credits{font-size:13px;margin-top:35px;overflow-wrap:anywhere}.explore-credits li{margin:14px 0}.explore-credits summary{padding:12px 0}.explore-figure{margin:0 0 20px}.explore-photo{width:100%;height:210px;object-fit:cover}.explore-figure figcaption{font-size:11px;color:var(--muted);margin-top:6px}.entry-title{font-size:28px;margin-bottom:12px}.filter-form label{min-width:0}.filter-form select{font:inherit;font-size:16px;padding:13px 16px;border:1px solid var(--line);background:var(--light);color:var(--ink);max-width:100%}.results-heading{display:flex;justify-content:space-between;gap:20px;margin-bottom:25px;align-items:center}.results-heading p{margin:0}.results-heading a{font-size:14px;padding:10px 0}.filters a{min-height:44px;display:inline-flex;align-items:center}@media(max-width:700px){.filter-form{flex-direction:column;align-items:stretch}.filter-form label{width:100%}.explore-photo{height:auto;aspect-ratio:1.6}.results-heading{align-items:start}}</style>
