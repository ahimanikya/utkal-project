---
import {allowsStarter,isCoastalEdition} from '../data/edition';
import Shell from '../layouts/Shell.astro';
import selection from '../../../../kb/research/journey-starters.json';
import {journeyCatalog} from '../data/journey-catalog';
import {bookPhotos} from '../data/book-photos';
const starters=selection.starters.filter(s=>allowsStarter(s.id)).map(s=>({...s,photo:bookPhotos[s.cover],ideas:s.items.map(id=>{const item=journeyCatalog.find(i=>i.id===id);if(!item)throw Error('Missing starter idea: '+id);return item;})}));
---
<Shell title="Journey starters" active="journey" wide><div class="wrap"><header class="page-head"><p class="eyebrow">A little inspiration · your own pace</p><h1>Start with a thread.<br/><em class="highlight">Make it your own.</em></h1><p class="lead">{isCoastalEdition?'Choose city, craft and coast, or begin at one Chilika gateway. Each starting point becomes a separate journey you can rename, rearrange and add to.':'Choose a few places or a handful of stories. These starting points become separate journeys you can rename, rearrange and add to.'}</p><p>Every idea starts under “Ideas for later”, with no dates assigned. These are research collections, not checked travel routes.</p><div class="actions"><a class="text-link" href="/journey/">Open my saved journeys →</a><a class="text-link" href={isCoastalEdition?'/explore/?topic=Places':'/destinations/'}>Browse destinations →</a></div></header>
<noscript><p class="notice">Enable JavaScript to create a journey. You can still follow every reading link below.</p></noscript>
<section class="starter-grid" aria-label="Choose a journey starter">{starters.map(s=><article id={s.id} class="starter-card utk-card"><figure><img src={s.photo.src} alt={s.photo.alt} width={s.photo.width} height={s.photo.height} loading="lazy"/></figure><div><p class="eyebrow">{s.type} · {s.ideas.length} ideas</p><h2>{s.title}</h2><p>{s.lead}</p><ol>{s.ideas.map(i=><li><a href={i.href}>{i.title}</a><small>{i.kind}</small></li>)}</ol><button type="button" class="button utk-button" data-journey-starter={s.id} disabled aria-describedby={'starter-status-'+s.id}>Start {s.title}</button><p id={'starter-status-'+s.id} class="starter-status" data-starter-status role="status" aria-live="polite"></p></div></article>)}</section>
<p class="notice">Saved only in this browser, alongside your existing journeys. You can keep up to ten; export a backup from My journey to keep a copy elsewhere.</p>
<details class="utk-disclosure starter-credits"><summary>Photographs & editorial notes</summary><p>Selections draw from the linked Utkal Project entries. Sources and research dates are available in each guide. Human editorial review remains pending.</p><ul>{starters.map(s=><li><a href={s.photo.source}>{s.photo.caption||s.photo.alt}</a> · {s.photo.creator} · <a href={s.photo.license_url}>{s.photo.license}</a>. {s.photo.changes}</li>)}</ul></details></div></Shell>
<style>
.starter-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px;padding-bottom:36px}.starter-card{min-width:0;background:var(--paper);overflow:hidden;display:flex;flex-direction:column}.starter-card figure{margin:0}.starter-card img{display:block;width:100%;height:auto;aspect-ratio:1.5;object-fit:cover}.starter-card>div{padding:28px;display:flex;flex-direction:column;flex:1}.starter-card h2{font:clamp(28px,3vw,38px)/1.15 var(--serif);margin:15px 0 22px}.starter-card ol{padding-left:24px;margin:24px 0 30px;flex:1}.starter-card li{padding:8px 0 8px 4px}.starter-card small{display:block;color:var(--muted);font-size:12px}.starter-card button{white-space:normal;text-align:left;min-height:48px;overflow-wrap:anywhere}.starter-status{margin-top:18px;font-size:14px;min-height:24px}.starter-credits{font-size:13px;margin:30px 0 50px;overflow-wrap:anywhere}.starter-credits li{margin:12px 0}.starter-credits summary{padding:12px 0;cursor:pointer}@media(max-width:1000px){.starter-grid{grid-template-columns:1fr}.starter-card{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.4fr)}.starter-card img{height:100%;aspect-ratio:auto;min-height:280px}}@media(max-width:600px){.starter-card{display:flex}.starter-card img{height:auto;min-height:0;aspect-ratio:1.5}.starter-card>div{padding:24px}}
</style>
